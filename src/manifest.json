{
  "manifest_version": 3,
  "name": "Kinopoisk Shortcut",
  "version": "1.1.0",
  "description": "Adds a ticket-shaped button to Kinopoisk film pages that opens the same film on another site.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.kinopoisk.ru/*"],
      "css": ["content.css"],
      "js": ["config.js", "target.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
